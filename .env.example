FINNHUB_API_KEY="your_finnhub_key_here"
FIRECRAWL_API_KEY="your_firecrawl_key_here"
FIRECRAWL_API_URL="https://api.firecrawl.dev/v2/scrape"
FIRECRAWL_MAX_AGE_MS="172800000"
FIRECRAWL_TIMEOUT_SECONDS="60"
FIRECRAWL_CONCURRENCY="2"
DIRECT_AUTH_CACHE_TTL_SECONDS="1800"
DIRECT_API_TIMEOUT_SECONDS="30"
ENABLE_DIRECT_OPTIONS_FETCH="1"

# (Optional) Seed a valid Barchart cookie header to enable instant direct API queries without browser scraping
# BARCHART_DIRECT_COOKIE="_gcl_au=...; XSRF-TOKEN=...; laravel_session=..."
# BARCHART_DIRECT_XSRF="optional_xsrf_token_if_not_in_cookie"

