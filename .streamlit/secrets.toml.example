# Barchart Options API Configuration
# Copy this file to secrets.toml and update the values
# 
# Example:
#   cp secrets.toml.example secrets.toml
#   # Edit secrets.toml with your API URL

# Local development
API_BASE_URL = "http://localhost:8000"
FIRECRAWL_API_KEY = "your_firecrawl_key_here"
FIRECRAWL_API_URL = "https://api.firecrawl.dev/v2/scrape"
FIRECRAWL_MAX_AGE_MS = 172800000
FIRECRAWL_TIMEOUT_SECONDS = 60

# Production (update with your VPS IP or domain)
# API_BASE_URL = "http://your-vps-ip:8000"
# API_BASE_URL = "https://api.yourdomain.com"
